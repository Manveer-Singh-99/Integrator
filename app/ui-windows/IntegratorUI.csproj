<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Integrator</AssemblyName>
    <RootNamespace>IntegratorUI</RootNamespace>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icons\icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\icons\icon.ico">
      <Link>icon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Choose>
    <When Condition="'$(Platform)' == 'ARM64' And Exists('..\target\aarch64-pc-windows-msvc\release\integrator_core.dll')">
      <ItemGroup>
        <Content Include="..\target\aarch64-pc-windows-msvc\release\integrator_core.dll">
          <Link>integrator_core.dll</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>
    <When Condition="'$(Platform)' != 'ARM64' And Exists('..\target\x86_64-pc-windows-msvc\release\integrator_core.dll')">
      <ItemGroup>
        <Content Include="..\target\x86_64-pc-windows-msvc\release\integrator_core.dll">
          <Link>integrator_core.dll</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>
    <When Condition="Exists('..\target\release\integrator_core.dll')">
      <ItemGroup>
        <Content Include="..\target\release\integrator_core.dll">
          <Link>integrator_core.dll</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>
    <When Condition="'$(Platform)' == 'ARM64' And Exists('..\target\aarch64-pc-windows-msvc\debug\integrator_core.dll')">
      <ItemGroup>
        <Content Include="..\target\aarch64-pc-windows-msvc\debug\integrator_core.dll">
          <Link>integrator_core.dll</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>
    <When Condition="'$(Platform)' != 'ARM64' And Exists('..\target\x86_64-pc-windows-msvc\debug\integrator_core.dll')">
      <ItemGroup>
        <Content Include="..\target\x86_64-pc-windows-msvc\debug\integrator_core.dll">
          <Link>integrator_core.dll</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>
    <When Condition="Exists('..\target\debug\integrator_core.dll')">
      <ItemGroup>
        <Content Include="..\target\debug\integrator_core.dll">
          <Link>integrator_core.dll</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>
  </Choose>
</Project>
