{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacWindowsBridge",
  "version": "1.0.0",
  "identifier": "com.manveersingh.macwindowsbridge",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "Mac-Windows Fusion Bridge",
        "label": "main",
        "width": 840,
        "height": 640,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
